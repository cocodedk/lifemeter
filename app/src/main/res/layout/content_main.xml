<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Hero section (first launch only): the root of the included file is hero_section -->
    <include layout="@layout/content_main_hero" />

    <!-- Date card: its views are date_compact_row, first_launch_content and the two date buttons -->
    <include layout="@layout/content_main_date_card" />

    <!-- Results container (hidden until date is set). Each include below is a <merge>,
         so its views are direct children of this container, in this order. -->
    <LinearLayout
        android:id="@+id/results_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- LIFETIME TOTALS -->
        <include layout="@layout/content_main_overview" />

        <!-- THIS SESSION -->
        <include layout="@layout/content_main_session" />

        <!-- CURIOSITIES and the pull-down hint -->
        <include layout="@layout/content_main_story" />

    </LinearLayout>

</LinearLayout>
