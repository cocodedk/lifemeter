<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/about_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    tools:context=".AboutActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorToolbar"
            android:elevation="0dp"
            android:theme="@style/AboutToolbarControls"
            app:popupTheme="@style/AppTheme.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/about_name_version_title"
                style="@style/AboutSectionTitle"
                android:text="@string/about_name_version_title" />

            <com.google.android.material.card.MaterialCardView style="@style/AboutCard">

                <LinearLayout style="@style/AboutCardColumn">
                    <TextView
                        style="@style/AboutBody"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/app_name"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/about_version"
                        style="@style/AboutBody"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/colorTextSecondary"
                        tools:text="Version 0.1.3 (1003)" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/about_check_updates"
                        style="@style/AboutPrimaryButton"
                        android:text="@string/about_check_updates" />

                    <TextView
                        android:id="@+id/about_update_hint"
                        style="@style/AboutBody"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/about_what_title"
                style="@style/AboutSectionTitle"
                android:text="@string/about_what_title" />

            <com.google.android.material.card.MaterialCardView style="@style/AboutCard">

                <LinearLayout style="@style/AboutCardColumn">
                    <TextView
                        style="@style/AboutBody"
                        android:text="@string/about_what_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/about_privacy_title"
                style="@style/AboutSectionTitle"
                android:text="@string/about_privacy_title" />

            <com.google.android.material.card.MaterialCardView style="@style/AboutCard">

                <LinearLayout style="@style/AboutCardColumn">
                    <TextView
                        style="@style/AboutBody"
                        android:text="@string/about_privacy_body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/about_privacy_link"
                        style="@style/AboutLinkButton"
                        android:layout_marginTop="14dp"
                        android:text="@string/about_privacy_link" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/about_links_title"
                style="@style/AboutSectionTitle"
                android:text="@string/about_links_title" />

            <com.google.android.material.card.MaterialCardView style="@style/AboutCard">

                <LinearLayout style="@style/AboutCardColumn">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/about_website"
                        style="@style/AboutLinkButton"
                        android:text="@string/about_website" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/about_source"
                        style="@style/AboutLinkButton"
                        android:layout_marginTop="10dp"
                        android:text="@string/about_source" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/about_report"
                        style="@style/AboutLinkButton"
                        android:layout_marginTop="10dp"
                        android:text="@string/about_report" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/about_credits_title"
                style="@style/AboutSectionTitle"
                android:text="@string/about_credits" />

            <com.google.android.material.card.MaterialCardView style="@style/AboutCard">

                <LinearLayout style="@style/AboutCardColumn">
                    <TextView
                        style="@style/AboutBody"
                        android:text="@string/about_license" />

                    <TextView
                        style="@style/AboutBody"
                        android:layout_marginTop="10dp"
                        android:text="@string/credit_un" />

                    <TextView
                        style="@style/AboutBody"
                        android:layout_marginTop="10dp"
                        android:text="@string/credit_food" />

                    <TextView
                        style="@style/AboutBody"
                        android:layout_marginTop="10dp"
                        android:text="@string/credit_curiosities" />

                    <TextView
                        style="@style/AboutBody"
                        android:layout_marginTop="10dp"
                        android:text="@string/credit_libraries" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/about_made_by_title"
                style="@style/AboutSectionTitle"
                android:text="@string/about_made_by_title" />

            <com.google.android.material.card.MaterialCardView style="@style/AboutCard">

                <LinearLayout style="@style/AboutCardColumn">
                    <TextView
                        style="@style/AboutBody"
                        android:text="@string/about_made_by" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 7. Support: an empty slot until the Support phase; nothing is shown here. -->

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
